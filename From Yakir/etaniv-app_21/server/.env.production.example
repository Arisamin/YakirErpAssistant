# ===== משתני סביבה לייצור — שרת אתניב =====
# חשוב: אין להעלות קובץ זה עם ערכים אמיתיים למאגר Git.
# הערכים מוזנים בלוח הבקרה של ספק האירוח (Render וכו').

# מחרוזת החיבור ממסד הנתונים המנוהל (Neon / Supabase / Render Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require"

# סודות אימות — צור ערכים אקראיים חזקים!  scripts/gen-secrets.sh
# (או: openssl rand -base64 48)
JWT_ACCESS_SECRET="<48-byte-random>"
JWT_REFRESH_SECRET="<48-byte-random-different>"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# משתמש מנהל ראשוני (נוצר בזריעה) — החלף סיסמה חזקה, והחלף אותה שוב בכניסה הראשונה
ADMIN_EMAIL="yakir@etaniv.co.il"
ADMIN_NAME="יקיר אתניב"
ADMIN_PASSWORD="<strong-temporary-password>"

# כללי
NODE_ENV="production"
PORT="4000"
# כתובת ה-PWA בייצור (למדיניות CORS). מופרד בפסיקים.
CORS_ORIGINS="https://app.etaniv.co.il"
